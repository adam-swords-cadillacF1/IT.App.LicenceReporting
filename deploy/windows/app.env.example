# Licence Reporting - server settings
# Lives at C:\ProgramData\LicenceReportingApp\app.env (readable by SYSTEM and Administrators only).
# Never commit the real file or copy it into the app folder.

PORT=3003
APP_URL=https://licencereporting.hermes.uk.net
# Snapshot dates, "late" (after 01:00) and month ends use this time zone
APP_TZ=Europe/London
# The database, the group list the snapshot task reads, incoming snapshot files and logs
DATA_DIR=C:\ProgramData\LicenceReportingApp\data

# Long random value; Install-App.ps1 generates one if this is empty
SESSION_SECRET=

# Sign-in: "entra" for Microsoft sign-in. "dev" (no password) only listens on the server itself.
AUTH_MODE=entra

# Entra app registration for sign-in only (no Graph permissions needed). Its app roles decide access:
#   Admin  - IT (group list, snapshot history, take snapshot now, retention, activity log)
#   Viewer - Finance (dashboard and reports, read-only)
# A certificate is preferred over a secret.
ENTRA_TENANT_ID=526e3dd0-65ab-4277-b37b-3483ad0e0846
ENTRA_CLIENT_ID=c89556f8-5fc6-4d56-9d92-6025469b82d1
ENTRA_CERT_KEY_PATH=C:\ProgramData\LicenceReportingApp\certs\entra-key.pem
ENTRA_CERT_THUMBPRINT=
# ENTRA_CLIENT_SECRET=

# The scheduled task the "Take snapshot now" button starts (Install-SnapshotTask.ps1 creates it)
SNAPSHOT_TASK=LicenceReporting snapshot

# HTTPS. The reverse proxy on sl-pvs-dock02 (10.1.0.233) holds the certificate and forwards to this server
# on PORT, so the app trusts that proxy's X-Forwarded-* headers and nothing else.
TRUST_PROXY=10.1.0.233
# The port is only opened in Windows Firewall for these addresses, so nobody can bypass the proxy.
FIREWALL_ALLOW_FROM=10.1.0.233
