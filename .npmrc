# Project-only npm settings. These apply to this folder alone and do not
# change the global/user npm config used by other projects.

# Approved source only (organisation policy) - never fall back to public npm
registry=https://artifactory.hermes.uk.net/artifactory/api/npm/npm-all/

# Trust the internal HERMES CA chain; TLS validation stays ON
cafile=./certs/hermes-ca.pem
strict-ssl=true

# Pin exact versions and refuse to run on the wrong Node version
save-exact=true
engine-strict=true

# Block package install scripts by default; allow per-package only after review
ignore-scripts=true

# Keep audit on
audit=true
fund=false
